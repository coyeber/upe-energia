# Desenvolvimento local com `vercel dev`
# Chave privada do serviço de análise: nunca coloque esta chave em VITE_* ou dentro de src/
GEMINI_API_KEY=COLE_SUA_CHAVE_GEMINI_AQUI
GEMINI_MODEL=gemini-3.5-flash-lite

# Login / Supabase
# Deixe false enquanto ainda estiver configurando o projeto.
VITE_AUTH_ENABLED=false
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública/anon do Supabase. Nunca use service_role no frontend.
VITE_SUPABASE_ANON_KEY=COLE_SUA_CHAVE_PUBLICA_AQUI
